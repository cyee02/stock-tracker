# Add these to ~/.zshrc on the Mac mini (then `chmod 600 ~/.zshrc`).
# deploy/deploy.sh reads them from your environment, or from ~/.zshrc when the
# GitHub Actions runner calls it. They never go to GitHub.
# One set serves every app on the Mac mini.

# One Tailscale auth key per app: TS_AUTHKEY_<REPO>, uppercased with - as _
# (e.g. TS_AUTHKEY_MQF_SHORTS). It's used only for that app's first start; the
# sidecar's identity is then kept in its tailscale-state volume. Create keys at
# https://login.tailscale.com/admin/settings/keys
export TS_AUTHKEY___APP_ENV__="tskey-auth-REPLACE_ME"

# Long-lived Claude token for apps that call the Claude CLI: run
# `claude setup-token` on any machine where you can sign in to Claude.
export CLAUDE_CODE_OAUTH_TOKEN="REPLACE_ME"

# Tailnet logins allowed in, comma-separated (for apps that check them).
export TAILSCALE_ALLOWED_LOGINS="you@example.com"

# Your time zone.
export TZ="Asia/Singapore"
